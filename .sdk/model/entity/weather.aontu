                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/weather/{city}"
          parts: [
            "v2"
            "weather"
            "{id}"
          ]
          rename: {
            param: {
              city: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                example: "Berlin"
                kind: "param"
                name: "id"
                orig: "city"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/weather/{city}"
          parts: [
